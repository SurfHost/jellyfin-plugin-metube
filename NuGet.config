<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Pinned explicitly so the build does not depend on whatever sources happen
      to be configured on the machine. Jellyfin.Controller is published to
      nuget.org.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
